{
  "name": "orcrustrator-gui",
  "version": "0.1.1",
  "description": "Lightweight companion studio for Orcrustrator relational API aggregator",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Benzi Darwin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenziDarwin/Orcrustrator.git",
    "directory": "ui"
  },
  "keywords": [
    "orcrustrator",
    "api-aggregator",
